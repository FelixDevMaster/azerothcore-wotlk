#
# Rated Battlegrounds (MoP-style) for 3.3.5a
# Copy to the worldserver config directory or merge into worldserver.conf
#

###################################################################################################
# RATED BATTLEGROUNDS
#
#    RatedBG.Enable
#        Description: Enable the Rated Battleground queue, commands, and NPC.
#        Default:     1
#
#    RatedBG.MinLevel
#        Description: Minimum character level required to queue.
#        Default:     80
#
#    RatedBG.TeamSize
#        Description: Players required per team (MoP RBGs are 10v10).
#        Default:     10
#
#    RatedBG.Maps
#        Description: Comma-separated BattlegroundTypeId pool.
#                     2 = Warsong Gulch, 3 = Arathi Basin, 7 = Eye of the Storm,
#                     9 = Strand of the Ancients. AV (1) and IoC (30) are omitted
#                     because they are 40-player maps.
#        Default:     "2,3,7,9"
#
#    RatedBG.AllowSameFaction
#        Description: Allow two groups of the same faction to be matched (assigned
#                     to opposite BG sides). Healing/buffs between sides need a
#                     cross-faction BG module. Leave at 0 for Alliance vs Horde only.
#        Default:     0
#
#    RatedBG.StartRating / RatedBG.StartMMR
#        Description: Initial personal rating and matchmaking rating.
#        Default:     1500 / 1500
#
#    RatedBG.MaxRatingDiff
#        Description: Starting MMR window used to pair teams.
#        Default:     150
#
#    RatedBG.RatingDiscardTimer
#        Description: After this many milliseconds in queue, MMR is ignored (arena-style).
#        Default:     300000 (5 minutes)
#
#    RatedBG.QueueUpdateInterval
#        Description: How often the matcher runs, in milliseconds.
#        Default:     1000
#
#    RatedBG.HonorWin / RatedBG.HonorLoss
#        Description: Extra honor awarded at the end of an RBG (on top of BG honor).
#        Default:     378 / 189
#
#    RatedBG.ArenaPointsWinBase / RatedBG.ArenaPointsWinScale
#        Description: Arena points granted to winners (LK stand-in for Conquest).
#                     Final amount scales with personal rating and is capped weekly.
#        Default:     180 / 1.3
#
#    RatedBG.WeeklyCap
#        Description: Weekly arena-point cap from RBG wins (MoP Conquest-style).
#        Default:     1650
#
#    RatedBG.NPCEntry
#        Description: creature_template.entry of the RBG battlemaster (must match SQL).
#        Default:     190010
#
#    RatedBG.AnnounceQueue
#        Description: Broadcast a world message when a team queues.
#        Default:     0
#
#    RatedBG.EnableTitles
#        Description: Grant legacy PvP rank titles as rating thresholds are reached.
#        Default:     0
#

RatedBG.Enable = 1
RatedBG.MinLevel = 80
RatedBG.TeamSize = 10
RatedBG.Maps = "2,3,7,9"
RatedBG.AllowSameFaction = 0
RatedBG.StartRating = 1500
RatedBG.StartMMR = 1500
RatedBG.MaxRatingDiff = 150
RatedBG.RatingDiscardTimer = 300000
RatedBG.QueueUpdateInterval = 1000
RatedBG.HonorWin = 378
RatedBG.HonorLoss = 189
RatedBG.ArenaPointsWinBase = 180
RatedBG.ArenaPointsWinScale = 1.3
RatedBG.WeeklyCap = 1650
RatedBG.NPCEntry = 190010
RatedBG.AnnounceQueue = 0
RatedBG.EnableTitles = 0
RatedBG.WinRatingModifier1 = 48
RatedBG.WinRatingModifier2 = 24
RatedBG.LoseRatingModifier = 24
RatedBG.MatchmakerRatingModifier = 24

###################################################################################################
# ARENAS (1v1 personal, 2v2 arena team, 3v3 SoloQ personal)
#
# 1v1 and 3v3 keep a module-owned personal rating in arena_solo_stats.
# 2v2 gives each character a personal 2v2 arena_team (captain = character GUID)
# on login or first queue. A party of two can queue without sharing a charter.
# After the match the module writes arena_team + arena_team_member
# (personalRating, week/season games) and character_arena_stats slot 0 (MMR).
# ArenaSolo.2v2.HonorWin / HonorLoss are paid by the module. Weekly arena
# points still come from the core team distribution.
#
#    ArenaSolo.Enable
#        Description: Master switch for all three queues.
#        Default:     1
#
#    ArenaSolo.CrossFaction
#        Description: Allow mixing factions inside a team, and Alliance-vs-Alliance
#                     or Horde-vs-Horde matches. Solo queue barely fills without
#                     this, and the core already handles cross-faction arena
#                     groups. Set to 0 for Alliance vs Horde only.
#        Default:     1
#
#    ArenaSolo.QueueUpdateInterval
#        Description: How often the matcher runs, in milliseconds.
#        Default:     1000
#
#    ArenaSolo.NPCEntry
#        Description: creature_template.entry of the arena queue NPC (must match SQL).
#        Default:     190011
#
#    ArenaSolo.AnnounceQueue
#        Description: Broadcast a world message when someone queues.
#        Default:     0
#
#    ArenaSolo.3v3.RequireHealer
#        Description: Require one healer per team in 3v3 SoloQ (1 healer + 2 damage).
#                     Turning this off matches any six players.
#        Default:     1
#
#    Per-bracket options, with <B> being 1v1, 2v2 or 3v3:
#        ArenaSolo.<B>.Enable                    (default 1)
#        ArenaSolo.<B>.MinLevel                  (default 80)
#        ArenaSolo.<B>.StartRating / StartMMR     (default 1500 / 1500)
#        ArenaSolo.<B>.MaxRatingDiff             (default 150)
#        ArenaSolo.<B>.RatingDiscardTimer        (default 300000, ms)
#        ArenaSolo.<B>.HonorWin / HonorLoss      (default 189 / 94)
#        ArenaSolo.<B>.ArenaPointsWin            (default 30)
#        ArenaSolo.<B>.WeeklyCap                 (default 1350)
#        ArenaSolo.<B>.WinRatingModifier1        (default 48)
#        ArenaSolo.<B>.WinRatingModifier2        (default 24)
#        ArenaSolo.<B>.LoseRatingModifier        (default 24)
#        ArenaSolo.<B>.MatchmakerRatingModifier  (default 24)
#

ArenaSolo.Enable = 1
ArenaSolo.CrossFaction = 1
ArenaSolo.QueueUpdateInterval = 1000
ArenaSolo.NPCEntry = 190011
ArenaSolo.AnnounceQueue = 0
ArenaSolo.3v3.RequireHealer = 1

ArenaSolo.1v1.Enable = 1
ArenaSolo.1v1.MinLevel = 80
ArenaSolo.1v1.StartRating = 1500
ArenaSolo.1v1.StartMMR = 1500
ArenaSolo.1v1.MaxRatingDiff = 150
ArenaSolo.1v1.RatingDiscardTimer = 300000
ArenaSolo.1v1.HonorWin = 189
ArenaSolo.1v1.HonorLoss = 94
ArenaSolo.1v1.ArenaPointsWin = 25
ArenaSolo.1v1.WeeklyCap = 1000
ArenaSolo.1v1.WinRatingModifier1 = 48
ArenaSolo.1v1.WinRatingModifier2 = 24
ArenaSolo.1v1.LoseRatingModifier = 24
ArenaSolo.1v1.MatchmakerRatingModifier = 24

ArenaSolo.2v2.Enable = 1
ArenaSolo.2v2.MinLevel = 80
ArenaSolo.2v2.StartRating = 1500
ArenaSolo.2v2.StartMMR = 1500
ArenaSolo.2v2.MaxRatingDiff = 150
ArenaSolo.2v2.RatingDiscardTimer = 300000
ArenaSolo.2v2.HonorWin = 189
ArenaSolo.2v2.HonorLoss = 94
ArenaSolo.2v2.ArenaPointsWin = 30
ArenaSolo.2v2.WeeklyCap = 1200
ArenaSolo.2v2.WinRatingModifier1 = 48
ArenaSolo.2v2.WinRatingModifier2 = 24
ArenaSolo.2v2.LoseRatingModifier = 24
ArenaSolo.2v2.MatchmakerRatingModifier = 24

ArenaSolo.3v3.Enable = 1
ArenaSolo.3v3.MinLevel = 80
ArenaSolo.3v3.StartRating = 1500
ArenaSolo.3v3.StartMMR = 1500
ArenaSolo.3v3.MaxRatingDiff = 150
ArenaSolo.3v3.RatingDiscardTimer = 300000
ArenaSolo.3v3.HonorWin = 189
ArenaSolo.3v3.HonorLoss = 94
ArenaSolo.3v3.ArenaPointsWin = 35
ArenaSolo.3v3.WeeklyCap = 1350
ArenaSolo.3v3.WinRatingModifier1 = 48
ArenaSolo.3v3.WinRatingModifier2 = 24
ArenaSolo.3v3.LoseRatingModifier = 24
ArenaSolo.3v3.MatchmakerRatingModifier = 24
